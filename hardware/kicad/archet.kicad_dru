(version 1)
# Archet custom rules, generated by gen/netclasses.py: do not edit by hand.
# Net classes (clearances, widths, impedances) live in archet.kicad_pro.

# PoE isolation barrier: 1500 Vrms (IEEE 802.3 clause 33.4.1, DP5700 rating), 2121 V peak.
# 2.0 mm between the primary nets and everything else, zones included.
(rule "PoE barrier"
  (constraint clearance (min 2.0mm))
  (condition "(A.NetName == '/PoE/POE_DA' || A.NetName == '/PoE/POE_DB' || A.NetName == '/PoE/POE_SA' || A.NetName == '/PoE/POE_SB' || A.NetName == '/PoE/POE_VP' || A.NetName == '/PoE/POE_VN' || A.NetName == '/PoE/POE_TYP2' || A.NetName == '/PoE/POE_OPTO_A') && (B.NetName != '/PoE/POE_DA' && B.NetName != '/PoE/POE_DB' && B.NetName != '/PoE/POE_SA' && B.NetName != '/PoE/POE_SB' && B.NetName != '/PoE/POE_VP' && B.NetName != '/PoE/POE_VN' && B.NetName != '/PoE/POE_TYP2' && B.NetName != '/PoE/POE_OPTO_A')"))

# The magjack and the PD module carry both sides on their own pads: their geometry is the manufacturer's.
# Pad to pad only (both items in the footprint); tracks keep the barrier.
(rule "Barrier parts, own pads"
  (constraint clearance (min 0.1mm))
  (condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3') || A.memberOfFootprint('U6') && B.memberOfFootprint('U6')"))
