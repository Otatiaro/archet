	(text "VIN_BUS BOOST"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "29427888-db29-52f1-b358-143e1be63d43")
	)
	(text "VIN_BUS = the higher of the boost (24.5 V) and VIN_EXT through U52/Q10. With VIN_EXT present, Q9 holds UVLO\nlow: a 12 V VIN_EXT is passed through, never boosted. On USB or PoE the firmware enables the boost\n(BOOST_EN) within the source budget. Values simulated in hardware/sim/boost.py.\nLayout: C119/C120, Q8, R116 and D17 in one tight loop on the PGND side; CS and FB tracks away from SW."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "6b8145ba-c05b-5918-9c95-cb5a504eb3ea")
	)
