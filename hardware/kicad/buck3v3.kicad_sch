	)
	(text "Two identical 2 A converters: +3V3 feeds the probe (520 mA max), +3V3_AUX feeds the 3V3_OUT eFuse\n(1 A ceiling), so a shield or target short never pulls the probe rail down.\nLayout: input capacitor against VIN and GND, short SW node, FB divider away from the inductor."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "1b4995c1-4b9b-5d12-af74-b22ee59b6af5")
	)
