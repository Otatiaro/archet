	(text "Ethernet PHY"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c181c852-f2ee-5018-aca8-a500e06ba734")
	)
	(text "LAN8742A 10/100 PHY on the RMII of the MCU. REF_CLK Out mode: the PHY makes the 50 MHz REF_CLK from its own 25 MHz crystal\nand drives PA1 (nINTSEL low through R41); its nINT output is then lost, the link is polled over MDIO.\nR42 holds the PHY in reset until the firmware drives ETH_PHY_RST (PG6) high; the straps are latched at that edge:\nMODE[2:0] = 111 (all capable, auto-negotiation) and PHYAD = 0, both by the internal pulls. Internal 1.2 V regulator (REGOFF low)."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "820f98a3-3bb7-5f41-b84f-09691a38f61c")
	)
