	(text "TARGET SUPPLY"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "170f3c9a-8023-58e0-848a-d1c27eb32136")
	)
	(text "+5V -> TGT_VSUP 1.4-5.2 V (5.44 V worst case), 1 A limit enforced by the firmware from the INA226.\nTGT_VSET (DAC1_OUT1) injects into the FB node: 0 V -> 5.29 V, 3.3 V -> 1.17 V, ~1 mV per step (hardware/sim/tgt_vsup.py).\nFirmware: set the DAC before EN, DAC buffer on, ramp the setpoint, stay within 1.65-5.04 V; DAC pin high-Z -> 4.67 V. PS/SYNC low: power save,\nthe converter never sinks current from a back-driving target. PG unused. INA226 at 0x45 on I2C5.\nLayout: input capacitors against VIN/PGND, FB divider next to pin 2 (GND), shunt with Kelvin traces."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "8d30398f-a3aa-5701-b21d-0a939a6a1843")
	)
