		(uuid "f360cd08-9431-5c04-b144-98dc4c6fa021")
	)
	(text "USB3320C ULPI transceiver for the OTG_HS controller (480 Mbit/s); D+/D- come from the USB-C connector after the ESD array.\nR33 holds RESETB low: PHY suspended, ULPI outputs high-Z, so CLKOUT stays off PA5 (SPI1_SCK of the ROM bootloader)\nuntil the firmware drives ULPI_RST (PD10) high. REFSEL[2:0] = 111: 24 MHz crystal."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "778190c6-c273-534d-aaee-08e786638a75")
	)
